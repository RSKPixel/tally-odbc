# Host port published by frontend/nginx
TALLYSYNC_PORT=8006

# External MySQL (not managed by this compose file).
# Use a hostname reachable FROM INSIDE the backend container.
# Remote MySQL: the real host (e.g. homeserver). Same machine: host.docker.internal
MYSQL_HOST=homeserver
MYSQL_USER=sysadmin
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=tallysync
MYSQL_PORT=3306
SUPERUSER_PASSWORD=change-me

ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Tally HTTP. Must resolve from inside the backend container (e.g. officehq).
TALLY_HOST=officehq
TALLY_PORT=9000
SQLITE_PATH=/data/app.sqlite
